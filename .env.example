# Copy this file to .env and fill in real values locally.
# Never commit .env or expose real API keys.

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Local Sentence-Transformers model (no paid embedding API required)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Local persistence and run artifacts
CHROMA_PERSIST_DIR=.forgeai/chroma
ARTIFACTS_DIR=artifacts/runs

